FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/functions";
    object      vortexID;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Q-criterion (second invariant of grad U) and vorticity: tip/root vortices
Q
{
    type            Q;
    libs            (fieldFunctionObjects);
    field           U;
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
}
vorticity
{
    type            vorticity;
    libs            (fieldFunctionObjects);
    executeControl  timeStep;
    executeInterval 1;
    writeControl    writeTime;
}
