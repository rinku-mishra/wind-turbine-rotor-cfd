FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/functions";
    object      wallDiagnostics;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

yPlus
{
    type            yPlus;
    libs            (fieldFunctionObjects);
    writeControl    writeTime;
}
solverInfo
{
    type            solverInfo;
    libs            (utilityFunctionObjects);
    fields          (U p);
    writeResidualFields no;
}
courant
{
    type            CourantNo;
    libs            (fieldFunctionObjects);
    writeControl    writeTime;
}
