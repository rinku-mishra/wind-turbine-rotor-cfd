FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/functions";
    object      rotorLoads;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Integrated pressure + viscous load on rotor (blades + spinner), every step.
// Thrust = +Fx (downwind). Aerodynamic driving torque = -Mx (rotor axis is -x).
rotorLoads
{
    type            forces;
    libs            (forces);
    patches         (blades hub);
    rho             rhoInf;
    rhoInf          $rhoRef;
    CofR            $rotorOrigin;
    writeControl    timeStep;
    writeInterval   1;
    log             true;
}

bladeLoads
{
    $rotorLoads;
    patches         (blades);
    log             false;
}
