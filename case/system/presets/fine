FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/presets";
    object      fine;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// FINE: mesh-convergence check (~12-15 M cells, cluster)
preset          fine;
dx              0.04;
lBlade          7;      // 0.31 mm
lHub            5;
lRotor          3;      // 5 mm
lWake           2;
nLayers         5;
addLayers       true;
degPerStep      0.5;
nRevs           8;
avgFromRev      5;
nOuter          3;
